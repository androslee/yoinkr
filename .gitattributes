# Keep hash-pinned JSON and source recipes identical in Windows/Linux checkouts.
* text=auto
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.html text eol=lf
*.css text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.asar binary
