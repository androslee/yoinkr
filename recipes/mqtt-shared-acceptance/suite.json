{
  "schema": 1,
  "kind": "shared-feature-suite",
  "id": "mqtt-raw-diff-shared-v1",
  "baselineSha256": "c6c80e0726fa75a7b4bc74e5bb1f417a5482490d7b7f292703d40c5dd5e62a86",
  "coverage": [
    {
      "baseline": "connection-and-empty",
      "shared": "connection-and-empty"
    },
    {
      "baseline": "json-previous",
      "shared": "json-previous"
    },
    {
      "baseline": "text-and-unicode",
      "shared": "text-and-unicode"
    },
    {
      "baseline": "malformed-json",
      "shared": "malformed-json"
    },
    {
      "baseline": "empty-payload",
      "shared": "empty-payload"
    },
    {
      "baseline": "bounded-large",
      "shared": "bounded-large"
    },
    {
      "baseline": "topic-switch",
      "shared": "topic-switch"
    }
  ],
  "normalization": {
    "version": 1,
    "ignore": [
      "host window chrome and outer layout",
      "history titles: timestamps/message numbers are host metadata",
      "gutter chart icons: plotting is an explicitly excluded capability",
      "topic labels: MQTT topic versus recipient editor URI"
    ],
    "variants": [
      "empty MQTT removes topic; component/recipient clear shows an empty container",
      "donor Ctrl+A selector defect can select extra surrounding text; verify coverage, retain full raw selection",
      "original stale-panel workaround explicitly reselects the topic in donor transport"
    ]
  },
  "performance": {
    "version": 2,
    "samples": 10,
    "warmOpenP95Ms": 1000,
    "rendererCpuOverheadMs": 50,
    "rendererCpuOverheadFraction": 0.25,
    "startupOverheadMs": 200,
    "startupOverheadFraction": 0.1,
    "lifecycleCycles": 50,
    "heapGrowthBytes": 16777216,
    "heapGrowthFraction": 0.1,
    "metric": "Renderer TaskDuration CPU deltas around committed comparisons; transport wall time retained separately because MQTT and editor input are different services. No assertion that end-to-end input transports have equal latency.",
    "sharedCorpusBytes": [
      1024,
      10240
    ],
    "recipientOnlyStressBytes": 102400,
    "donorTransport": {
      "maxMessageBytes": 20000,
      "source": "backend/src/index.ts",
      "sourceSha256": "8d50146b4b5e260e4b1a6dfe5d338d6815e79091e51d293bcf302a6c8f82a4c3",
      "decision": "Original MQTT transport slices payload buffers at 20,000 bytes. Compare untruncated shared corpora; keep 100 KiB recipient-only stress. No performance budget was relaxed."
    }
  },
  "scenarios": [
    {
      "id": "connection-and-empty",
      "steps": [
        {
          "action": "clear"
        },
        {
          "action": "observe",
          "id": "initial-empty",
          "empty": true
        }
      ]
    },
    {
      "id": "json-previous",
      "steps": [
        {
          "action": "input",
          "topic": "json",
          "messages": [
            "{\"temperature\":20,\"state\":\"idle\"}",
            "{\"temperature\":24,\"state\":\"running\"}"
          ]
        },
        {
          "action": "mode",
          "value": "diff"
        },
        {
          "action": "observe",
          "id": "json-diff",
          "counts": {
            "added": 2,
            "removed": 2,
            "against": "previous"
          },
          "screenshot": true
        },
        {
          "action": "mode",
          "value": "raw"
        },
        {
          "action": "observe",
          "id": "json-raw",
          "screenshot": true
        },
        {
          "action": "history",
          "index": 0
        },
        {
          "action": "mode",
          "value": "diff"
        },
        {
          "action": "observe",
          "id": "history-selected",
          "counts": {
            "added": 2,
            "removed": 2,
            "against": "selected"
          }
        },
        {
          "action": "history",
          "index": 0
        },
        {
          "action": "observe",
          "id": "history-deselected",
          "counts": {
            "added": 2,
            "removed": 2,
            "against": "previous"
          }
        },
        {
          "action": "mode",
          "value": "raw"
        },
        {
          "action": "select-code"
        },
        {
          "action": "copy"
        },
        {
          "action": "observe",
          "id": "selection-and-copy",
          "clipboard": true,
          "selection": true
        }
      ]
    },
    {
      "id": "text-and-unicode",
      "steps": [
        {
          "action": "input",
          "topic": "unicode",
          "messages": [
            "hello Ω world",
            "snow 雪 — café 🚀"
          ]
        },
        {
          "action": "mode",
          "value": "diff"
        },
        {
          "action": "observe",
          "id": "unicode-diff",
          "screenshot": true
        },
        {
          "action": "mode",
          "value": "raw"
        },
        {
          "action": "observe",
          "id": "unicode-raw"
        }
      ]
    },
    {
      "id": "malformed-json",
      "steps": [
        {
          "action": "input",
          "topic": "malformed",
          "messages": [
            "plain previous",
