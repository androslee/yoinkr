    {
      "id": "literal-markup",
      "steps": [
        {
          "action": "input",
          "topic": "literal",
          "messages": [
            "before",
            "<img src=x onerror=\"window.bad=true\"> & <script>bad()</script>"
          ]
        },
        {
          "action": "mode",
          "value": "raw"
        },
        {
          "action": "observe",
          "id": "markup-remains-text"
        }
      ]
