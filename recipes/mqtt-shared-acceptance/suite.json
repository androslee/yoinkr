          ]
        },
        {
          "action": "observe",
          "id": "switch-b"
        },
        {
          "action": "input",
          "topic": "switch-a-again",
          "messages": [
            "A previous",
            "A refreshed"
          ]
        },
        {
          "action": "observe",
          "id": "switch-a-refreshed"
